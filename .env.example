# ---------- App ----------
APP_ENV=development                       # development | staging | production
APP_URL=http://localhost:3000             # frontend origin
PUBLIC_PORTFOLIO_URL=http://localhost:3000
API_URL=http://localhost:8000

# Comma-separated list of allowed CORS origins (the frontend)
CORS_ORIGINS=http://localhost:3000

# ---------- Supabase ----------
# Project settings -> API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Project settings -> API -> JWT Settings -> JWT Secret (legacy HS256 secret)
SUPABASE_JWT_SECRET=your-jwt-secret
# Project settings -> API -> service_role key (SERVER ONLY, never ship to browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------- Database ----------
# Use the Supabase "Connection Pooling" (Transaction) connection string.
# Either scheme works, it is auto-normalised to postgresql+asyncpg://
# Example: postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql+asyncpg://postgres.YOUR_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
DB_SSL=true

# ---------- Username policy ----------
USERNAME_MIN_LENGTH=3
USERNAME_MAX_LENGTH=30
# How many days must pass between username changes (0 = unlimited)
USERNAME_CHANGE_COOLDOWN_DAYS=14

# ---------- Rate limits (slowapi syntax) ----------
RATE_LIMIT_USERNAME_CHECK=30/minute
RATE_LIMIT_USERNAME_SET=6/minute
RATE_LIMIT_DEFAULT_WRITE=60/minute
